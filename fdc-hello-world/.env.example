# ウォレットの秘密鍵（0x プレフィックスあり、Coston2用・C2FLRを入れておくこと）
# 警告: 本番環境の秘密鍵は絶対にコミットしないこと！
PRIVATE_KEY=0x...

# XRPL Testnetウォレットのシード（未設定でも 01-fund-xrpl-wallets.ts が新規生成可能）
XRPL_SEED=

# RPCエンドポイント（省略時はデフォルトのCoston2 RPCを使用）
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# FDC Verifier API（testnet）
# 実装時に最新の値を https://dev.flare.network/fdc/getting-started で再確認すること
VERIFIER_URL_TESTNET=https://fdc-verifiers-testnet.flare.network
VERIFIER_API_KEY_TESTNET=00000000-0000-0000-0000-000000000000

# FDC DA Layer（Coston2向け）
# 実装時に最新の値を https://dev.flare.network/fdc/reference/data-availability-api で再確認すること
COSTON2_DA_LAYER_URL=https://ctn2-data-availability.flare.network
